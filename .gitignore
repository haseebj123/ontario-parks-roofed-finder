# cache/availability.json IS committed. Vercel's AWS egress gets 403 from
# reservations.ontarioparks.ca, so the deployed app cannot scan for itself.
# A scheduled GitHub Action (which is not blocked) scans and commits it, and
# that commit is what ships fresh data to production.

# Raw park feed, ~560KB and rebuilt automatically by geocode.py.
cache/parks_raw.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Vercel
.vercel
.env
.env.*

# Written by `vercel build` when no Python manifest exists. They pin whatever
# Python the local machine happens to have, which is not necessarily the
# version Vercel builds with (it uses 3.12), so committing them would make
# deploys depend on whoever ran the build last.
pyproject.toml
uv.lock

# Local noise
server.log
*.log
.DS_Store
Thumbs.db

.vercel
